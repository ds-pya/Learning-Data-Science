package com.samsung.android.screenai.data.service.ocr

import com.samsung.android.screenai.domain.model.ocr.OcrBlock
import com.samsung.android.screenai.domain.service.OcrTextFormatter
import javax.inject.Inject
import kotlin.math.abs

/**
 * Gemini 앱 OCR → 구조화 텍스트 변환기
 *
 * ## 이상적인 출력 스키마
 * ```
 * [Gemini] Gemini Flash
 * ────────────────────────────────────────
 *
 * [질문]
 * 스기노이 호텔 주변 맛집
 *
 * [답변]
 * 벳부 스기노이 호텔 주변 및 벳부 시내의 대표적인 맛집을 도보 이동이 가능한 곳과
 * 차량/대중교통으로 가기 좋은 곳으로 나누어 추천해드립니다.
 *
 * 1. 호텔에서 도보 이동 가능한 주변 맛집
 * 스기노이 호텔이 위치한 관해지(Kankaiji) 온천 지대는 고지대에 있어 ...
 *
 *   • 고조 (Gojo / そば処 五条)
 *     특징: 호텔에서 도보로 약 5~10분 거리에 있는 아늑한 소바 및 우동 전문점
 *           (수·목요일 휴무 / 오후 3시까지만 영업)
 *     추천 메뉴: 냉소바, 우동 종류
 *
 *   • 춘코엔 (Shunkoen / 焼肉 春香苑)
 * ```
 *
 * ## 핵심 수정: 질문 오판정 문제
 * 문제: Gemini 답변 중 들여쓰기 블록들이 cx > 50% 조건에 걸려 [질문]으로 오분류됨
 *       (예: "특징: 호텔에서 도보로 약 5~10분", "메밀소바와 따뜻한 우동을 선보이며...")
 * 원인: Gemini 답변 텍스트가 화면 중앙~우측에 넓게 배치되어 cx 중앙값이 50%를 초과
 * 해결:
 *   1. QUESTION_CX_THRESHOLD 0.50 → 0.65 로 상향 (질문 버블은 우측 정렬이 더 뚜렷함)
 *   2. 질문 버블 추가 조건: width가 화면의 70% 미만 (답변 텍스트는 거의 full-width)
 *   3. 질문 버블 추가 조건: right edge가 화면 우측에 근접 (right > sw * 0.85)
 */
class GeminiOcrTextFormatter @Inject constructor() : OcrTextFormatter {

    override fun format(
        blocks: List<OcrBlock>,
        packageName: String?,
        screenWidth: Int,
        screenHeight: Int
    ): String? {
        if (!isGeminiPackage(packageName)) return null
        if (blocks.isEmpty()) return null

        val sw = if (screenWidth > 0) screenWidth else estimateScreenWidth(blocks)
        val sh = if (screenHeight > 0) screenHeight else estimateScreenHeight(blocks)

        val cleaned = deduplicateBlocks(filterUiNoise(blocks, sw, sh))
        val sorted  = cleaned.sortedBy { (it.boundingBox?.top ?: 0) + (it.boundingBox?.bottom ?: 0) }

        val modelName  = extractModelName(sorted, sw, sh)
        val classified = classifyBlocks(sorted, sw, sh)

        return render(modelName, classified)
    }

    // ─── 패키지 판별 ─────────────────────────────────────────────────────

    private fun isGeminiPackage(packageName: String?): Boolean =
        packageName in GEMINI_PACKAGES

    // ─── 노이즈 필터 ────────────────────────────────────────────────────

    private fun filterUiNoise(blocks: List<OcrBlock>, sw: Int, sh: Int): List<OcrBlock> {
        return blocks.filter { block ->
            val box  = block.boundingBox ?: return@filter false
            val cy   = (box.top + box.bottom) / 2.0
            val text = block.text.trim()

            if (cy < sh * STATUS_BAR_RATIO)               return@filter false
            if (cy > sh * (1.0 - BOTTOM_UI_RATIO))        return@filter false
            if (text.length == 1)                          return@filter false
            if ("에게 물어" in text || "Gemini에게" in text) return@filter false
            if (text.matches(Regex("""^[=≡|.]{1,3}$"""))) return@filter false

            true
        }
    }

    /**
     * 중복 블록 제거
     * 같은 영역의 블록 중 textQualityScore가 높은 쪽 선택.
     * 단독이어도 score < MIN_QUALITY_SCORE면 제거.
     */
    private fun deduplicateBlocks(blocks: List<OcrBlock>): List<OcrBlock> {
        val result = mutableListOf<OcrBlock>()
        val used   = mutableSetOf<Int>()

        for (i in blocks.indices) {
            if (i in used) continue
            val a = blocks[i]; val boxA = a.boundingBox ?: continue
            var best = a; var bestScore = textQualityScore(a.text)

            for (j in i + 1 until blocks.size) {
                if (j in used) continue
                val b = blocks[j]; val boxB = b.boundingBox ?: continue
                if (isSameRegion(boxA, boxB)) {
                    val s = textQualityScore(b.text)
                    if (s > bestScore) { bestScore = s; best = b }
                    used.add(j)
                }
            }
            if (bestScore >= MIN_QUALITY_SCORE) result.add(best)
            used.add(i)
        }
        return result
    }

    private fun isSameRegion(a: OcrBlock.BoundingBox, b: OcrBlock.BoundingBox): Boolean =
        abs(a.top - b.top) < DUPLICATE_Y_PX &&
        abs(a.bottom - b.bottom) < DUPLICATE_Y_PX &&
        abs(a.left - b.left) < DUPLICATE_X_PX

    private fun textQualityScore(text: String): Int {
        val korean = text.count { it in '\uAC00'..'\uD7A3' }
        val latin  = text.count { it.isLetter() && it < '\u0100' }
        val noise  = text.count { !it.isLetterOrDigit() && it !in " .,()%~-:/·•\n" }
        return korean * 3 + latin * 2 - noise * 4
    }

    // ─── 모델명 추출 ─────────────────────────────────────────────────────

    private fun extractModelName(blocks: List<OcrBlock>, sw: Int, sh: Int): String {
        return blocks
            .filter { block ->
                val box = block.boundingBox ?: return@filter false
                val cy  = (box.top + box.bottom) / 2.0
                val cx  = (box.left + box.right) / 2.0
                cy < sh * MODEL_HEADER_BOTTOM_RATIO &&
                cx > sw * 0.20 && cx < sw * 0.80 &&
                ("Gemini" in block.text || "Flash" in block.text || "Pro" in block.text)
            }
            .firstOrNull()
            ?.text
            ?.trim()
            ?.replace(Regex("""\s*[▼∨v]\s*$"""), "")
            ?: "Gemini"
    }

    // ─── 블록 분류 ───────────────────────────────────────────────────────

    private sealed class GeminiBlock {
        data class Question(val text: String, val cy: Int) : GeminiBlock()
        data class Answer(val text: String, val cy: Int, val indentLevel: Int) : GeminiBlock()
    }

    private fun classifyBlocks(blocks: List<OcrBlock>, sw: Int, sh: Int): List<GeminiBlock> {
        val headerBottomY = (sh * MODEL_HEADER_BOTTOM_RATIO).toInt()

        return blocks.mapNotNull { block ->
            val box  = block.boundingBox ?: return@mapNotNull null
            val text = block.text.trim()
            val cy   = (box.top + box.bottom) / 2

            if (cy < headerBottomY) return@mapNotNull null
            if (text.length < 2)    return@mapNotNull null

            if (isQuestionBubble(box, text, sw)) GeminiBlock.Question(text, cy)
            else                                  GeminiBlock.Answer(text, cy, indentLevel(box, sw))
        }
    }

    /**
     * 질문 버블 판별
     * [FIX] 세 가지 조건을 모두 만족해야 질문으로 판정:
     *   1. cx > sw * 0.65  (우측 정렬, 기존 0.50에서 상향)
     *   2. right > sw * 0.85  (버블 오른쪽 끝이 화면 우측에 근접)
     *   3. blockWidth < sw * 0.70  (답변 텍스트는 거의 풀-위드이므로 좁은 블록만)
     * 이 세 조건을 조합하면 답변 내 들여쓰기 텍스트가 질문으로 오분류되는 문제 해결
     */
    private fun isQuestionBubble(box: OcrBlock.BoundingBox, text: String, sw: Int): Boolean {
        val cx         = (box.left + box.right) / 2.0
        val blockWidth = box.right - box.left
        val isCxRight     = cx > sw * QUESTION_CX_THRESHOLD        // [FIX] 0.65
        val isRightEdge   = box.right > sw * QUESTION_RIGHT_EDGE   // [FIX] right > 85%
        val isNarrow      = blockWidth < sw * QUESTION_MAX_WIDTH    // [FIX] width < 70%
        val isShortText   = text.lines().size <= 3 && text.length < 100
        return isCxRight && isRightEdge && isNarrow && isShortText
    }

    private fun indentLevel(box: OcrBlock.BoundingBox, sw: Int): Int {
        val leftRatio = box.left.toDouble() / sw
        return when {
            leftRatio < 0.10 -> 0
            leftRatio < 0.20 -> 1
            else             -> 2
        }
    }

    // ─── 렌더링 ──────────────────────────────────────────────────────────

    private fun render(modelName: String, blocks: List<GeminiBlock>): String {
        val sb = StringBuilder()
        sb.appendLine("[Gemini] $modelName")
        sb.appendLine("─".repeat(40))

        var inAnswer      = false
        var lastWasQuestion = false

        blocks.forEach { block ->
            when (block) {
                is GeminiBlock.Question -> {
                    if (inAnswer) sb.appendLine()
                    sb.appendLine()
                    sb.appendLine("[질문]")
                    sb.appendLine(block.text)
                    inAnswer        = false
                    lastWasQuestion = true
                }
                is GeminiBlock.Answer -> {
                    if (lastWasQuestion) {
                        sb.appendLine()
                        sb.appendLine("[답변]")
                        inAnswer        = true
                        lastWasQuestion = false
                    }
                    val prefix = when (block.indentLevel) {
                        0    -> ""
                        1    -> "  • "
                        else -> "    "
                    }
                    val isNumberedHeader = block.text.matches(Regex("""^\d+\.\s+.+"""))
                    if (isNumberedHeader && block.indentLevel == 0) sb.appendLine()

                    block.text.split("\n").forEachIndexed { idx, line ->
                        val t = line.trim()
                        if (t.isNotEmpty()) {
                            val lp = if (idx == 0) prefix else " ".repeat(prefix.length)
                            sb.appendLine("$lp$t")
                        }
                    }
                }
            }
        }

        return sb.toString().trimEnd()
    }

    // ─── 유틸 ────────────────────────────────────────────────────────────

    private fun estimateScreenWidth(blocks: List<OcrBlock>): Int =
        (blocks.maxOfOrNull { it.boundingBox?.right ?: 0 } ?: 0) + 40

    private fun estimateScreenHeight(blocks: List<OcrBlock>): Int =
        (blocks.maxOfOrNull { it.boundingBox?.bottom ?: 0 } ?: 0) + 200

    companion object {
        val GEMINI_PACKAGES = setOf(
            "com.google.android.googlequicksearchbox",
            "com.google.android.apps.bard",
            "com.google.android.apps.gemini"
        )

        private const val DEFAULT_SCREEN_WIDTH  = 1080
        private const val DEFAULT_SCREEN_HEIGHT = 2400

        private const val STATUS_BAR_RATIO          = 0.04
        private const val BOTTOM_UI_RATIO           = 0.12
        private const val MODEL_HEADER_BOTTOM_RATIO = 0.10

        // [FIX] 질문 버블 판별 조건 강화 (기존 단일 cx>0.50 → 3중 조건)
        private const val QUESTION_CX_THRESHOLD = 0.65   // cx 비율 하한 (기존 0.50)
        private const val QUESTION_RIGHT_EDGE   = 0.85   // right edge 비율 하한
        private const val QUESTION_MAX_WIDTH    = 0.70   // block width 비율 상한

        private const val DUPLICATE_Y_PX       = 30
        private const val DUPLICATE_X_PX       = 40
        private const val MIN_QUALITY_SCORE     = 0
    }
}
